{{ form_start(form, { attr: { class: 'space-y-10' } }) }}
{{ form_errors(form) }}

{# Image de profil (Avatar rond épuré) #}
{% if form.imageProfilFile is defined %}
	<div class="flex flex-col items-center justify-center gap-3">
		<label class="block text-xs font-bold uppercase tracking-wider text-center" style="color: #a68dda;">
			Photo de profil
		</label>

		<div class="relative group cursor-pointer">
			<div class="w-32 h-32 rounded-full flex flex-col items-center justify-center text-center p-4 transition-all duration-200 border-2 border-dashed overflow-hidden relative" style="background: rgba(255, 255, 255, 0.05); border-color: rgba(166, 141, 218, 0.3);">

				<div class="flex flex-col items-center justify-center gap-1.5 z-10 pointer-events-none transition-transform duration-200 group-hover:scale-105">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="1.8" style="color: #a68dda;">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 21h12a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
					</svg>
					<span class="text-xs font-medium leading-tight text-center" style="color: #c4b3e8;">
						Ajouter une photo
					</span>
				</div>

				{{ form_widget(form.imageProfilFile.file, {
                    attr: {
                        class: 'absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20'
                    }
                }) }}
			</div>
		</div>

		{% if form.imageProfilFile.delete is defined %}
			<div class="flex items-center gap-2 mt-1">
				{{ form_widget(form.imageProfilFile.delete, {
                    attr: { class: 'w-4 h-4 rounded cursor-pointer accent-purple-600', style: 'accent-color: #7c5cbf;' }
                }) }}
				{{ form_label(form.imageProfilFile.delete, 'Supprimer l\'image actuelle', {
                    label_attr: { class: 'text-xs cursor-pointer', style: 'color: #a68dda;' }
                }) }}
            </div>
        {% endif %}

        {{ form_errors(form.imageProfilFile) }}
    </div>
{% endif %}

{# Nom / Prénom (2 colonnes) #}
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
        <label for="{{ form.nom.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
            Nom
        </label>
        {{ form_widget(form.nom, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: Dupont'
                }
            }) }}
        {{ form_errors(form.nom) }}
    </div>

    <div>
        <label for="{{ form.prenom.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-8" style="color: #a68dda;">
            Prénom
        </label>
        {{ form_widget(form.prenom, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: Jean'
                }
            }) }}
        {{ form_errors(form.prenom) }}
    </div>
</div>

{# Email / Téléphone (2 colonnes) #}
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
        <label for="{{ form.email.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
            Adresse Email
        </label>
        {{ form_widget(form.email, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: j.dupont@entreprise.fr'
                }
            }) }}
        {{ form_errors(form.email) }}
    </div>

    <div>
        <label for="{{ form.numTel.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
            Téléphone
        </label>
        {{ form_widget(form.numTel, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: 0692123456'
                }
            }) }}
        {{ form_errors(form.numTel) }}
    </div>
</div>

{# Rôles & Entreprise (2 colonnes, select uniformisés) #}
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
        <label for="{{ form.roles.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
            Rôle
        </label>
        <div class="relative">
            {{ form_widget(form.roles, {
                    attr: {
                        class: 'w-full appearance-none rounded-xl px-4 py-3 pr-10 text-sm transition duration-150 ease-in-out focus:outline-none cursor-pointer',
                        style: 'background: #1c1530; border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;'
                    }
                }) }}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none absolute right-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: #a68dda;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
        {{ form_errors(form.roles) }}
    </div>

    <div>
        <label for="{{ form.client.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
            Client rattaché
        </label>
        <div class="relative">
            {{ form_widget(form.client, {
                    attr: {
                        class: 'w-full appearance-none rounded-xl px-4 py-3 pr-10 text-sm transition duration-150 ease-in-out focus:outline-none cursor-pointer',
                        style: 'background: #1c1530; border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;'
                    }
                }) }}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none absolute right-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: #a68dda;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
        {{ form_errors(form.client) }}
    </div>
</div>

{# Mot de passe #}
<div>
    <label for="{{ form.plainPassword.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
        Mot de passe
    </label>
    {{ form_widget(form.plainPassword, {
            attr: {
                class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                placeholder: '••••••••'
            }
        }) }}
    {% if form.plainPassword.vars.help %}
        <p class="text-xs mt-1.5" style="color: #a68dda;">{{ form.plainPassword.vars.help }}</p>
    {% endif %}
    {{ form_errors(form.plainPassword) }}
</div>

{# Statut actif #}
<div class="p-4 rounded-xl flex items-center gap-3 cursor-pointer select-none" style="background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.15);">
    {{ form_widget(form.topActif, {
            attr: { class: 'w-5 h-5 rounded cursor-pointer accent-purple-600 focus:ring-0 shrink-0', style: 'accent-color: #7c5cbf;' }
        }) }}
    <label for="{{ form.topActif.vars.id }}" class="text-sm font-semibold cursor-pointer m-0 leading-none" style="color: #f3f0fb;">
        Compte actif
    </label>
</div>

{# Bouton de soumission #}
<div class="flex items-center justify-end mt-1 pt-8" style="border-top: 1px solid rgba(166, 141, 218, 0.2);">
    <button type="submit" class="inline-flex items-center gap-2 rounded-xl text-sm font-semibold text-white shadow-lg transition-all duration-200 hover:opacity-90 hover:shadow-xl" style="background: linear-gradient(135deg, #7c5cbf, #4a3480); padding: 12px 28px; min-width: 190px; justify-content: center;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
