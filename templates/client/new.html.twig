{% extends 'base.html.twig' %}

{% block title %}Nouveau Client
{% endblock %}

{% block body %}
	<div
		class="min-h-screen p-4 md:p-8 flex items-center justify-center" style="background: radial-gradient(circle at top left, #1a1428, #120d1f); font-family: system-ui, -apple-system, sans-serif;">

		{# Container Carte - thème sombre, bordure mauve subtile #}
		<div
			class="w-full max-w-3xl rounded-3xl p-6 md:p-10 shadow-2xl" style="background: linear-gradient(160deg, #241a3d 0%, #1c1530 100%); border: 1px solid rgba(166, 141, 218, 0.25); box-shadow: 0 25px 50px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(124, 92, 191, 0.08) inset;">

			{# En-tête #}
			<div class="flex items-center justify-between gap-4 pb-8" style="border-bottom: 1px solid rgba(166, 141, 218, 0.2);">
				<div class="flex items-center gap-4">
					<a href="{{ path('app_client_index') }}" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl transition-all duration-200" style="background: rgba(124, 92, 191, 0.12); color: #c4b3e8; border: 1px solid rgba(166, 141, 218, 0.2);">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
						</svg>
						Retour à la liste
					</a>
					<div>
						<h1 class="text-2xl font-extrabold tracking-tight" style="color: #f3f0fb;">Nouveau Client</h1>
						<p class="text-xs mt-0.5" style="color: #a68dda;">Enregistrer une nouvelle entreprise partenaire</p>
					</div>
				</div>
			</div>

			{# Formulaire #}
			<div class="pt-10">
				{{ include('client/_form.html.twig', {
                    'button_label': 'Créer le client'
                }) }}
			</div>

		</div>
	</div>
{% endblock %}
