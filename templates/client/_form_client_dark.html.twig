{{ form_start(form, { attr: { class: 'space-y-8' } }) }}
{{ form_errors(form) }}

{# Raison sociale #}
<div>
	<label for="{{ form.raisonSocial.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
		Raison sociale
	</label>
	{{ form_widget(form.raisonSocial, {
            attr: {
                class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                placeholder: 'Ex: Urcoopa'
            }
        }) }}
	{{ form_errors(form.raisonSocial) }}
</div>

{# Email / Téléphone (2 colonnes) #}
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
	<div>
		<label for="{{ form.email.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
			Email
		</label>
		{{ form_widget(form.email, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: contact@entreprise.fr'
                }
            }) }}
		{{ form_errors(form.email) }}
	</div>

	<div>
		<label for="{{ form.numTel.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
			Téléphone
		</label>
		{{ form_widget(form.numTel, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: 0262453710'
                }
            }) }}
		{{ form_errors(form.numTel) }}
	</div>
</div>

{# Adresse #}
<div>
	<label for="{{ form.adresse.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
		Adresse
	</label>
	{{ form_widget(form.adresse, {
            attr: {
                class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                placeholder: 'Ex: 36 Avenue Du Grand Piton, Cambaie'
            }
        }) }}
	{{ form_errors(form.adresse) }}
</div>

{# Code postal / Ville (2 colonnes) #}
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
	<div>
		<label for="{{ form.codePostal.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
			Code postal
		</label>
		{{ form_widget(form.codePostal, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: 97460'
                }
            }) }}
		{{ form_errors(form.codePostal) }}
	</div>

	<div>
		<label for="{{ form.ville.vars.id }}" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: #a68dda;">
			Ville
		</label>
		{{ form_widget(form.ville, {
                attr: {
                    class: 'w-full rounded-xl px-4 py-3 text-sm transition duration-150 ease-in-out focus:outline-none',
                    style: 'background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.25); color: #f3f0fb;',
                    placeholder: 'Ex: Saint-Paul'
                }
            }) }}
		{{ form_errors(form.ville) }}
	</div>
</div>

{# Statut actif - Alignement rigoureux #}
<div class="p-4 rounded-xl flex items-center gap-3 cursor-pointer select-none" style="background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.15);">
	{{ form_widget(form.topActif, {
            attr: { class: 'w-5 h-5 rounded cursor-pointer accent-purple-600 focus:ring-0 shrink-0', style: 'accent-color: #7c5cbf;' }
        }) }}
	<label for="{{ form.topActif.vars.id }}" class="text-sm font-semibold cursor-pointer m-0 leading-none" style="color: #f3f0fb;">
		Client actif
	</label>
</div>

{# Bouton de soumission #}
<div class="flex items-center justify-end pt-6" style="border-top: 1px solid rgba(166, 141, 218, 0.2);">
	<button type="submit" class="inline-flex items-center gap-2 rounded-xl text-sm font-semibold text-white shadow-lg transition-all duration-200 hover:opacity-90 hover:shadow-xl" style="background: linear-gradient(135deg, #7c5cbf, #4a3480); padding: 10px 24px; min-width: 180px; justify-content: center;">
		<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
			<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
		</svg>
		{{ button_label|default('Enregistrer') }}
	</button>
</div>

{{ form_end(form) }}
