{% extends 'base.html.twig' %}

{% block title %}Logiciels par client
{% endblock %}

{% block body %}
	<div
		class="min-h-screen p-4 md:p-8" style="background: radial-gradient(circle at top left, #1a1428, #120d1f); font-family: system-ui, -apple-system, sans-serif;">

		{# Container principal #}
		<div
			class="max-w-7xl mx-auto space-y-8">

			{# En-tête : Navigation & Titre principal #}
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6" style="border-bottom: 1px solid rgba(166, 141, 218, 0.2);">
				<div class="flex items-center gap-4">
					<a href="{{ path('app_ticket_index') }}" class="group inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl transition-all duration-200" style="color: #7c5cbf; background-color: #7c5cbf1a;" onmouseover="this.style.backgroundColor='#7c5cbf2e'" onmouseout="this.style.backgroundColor='#7c5cbf1a'">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
						</svg>
						Retour
					</a>
					<div>
						<h1 class="text-3xl font-extrabold tracking-tight" style="color: #f3f0fb;">Déploiements des Logiciels client</h1>
						<p class="text-xs mt-0.5" style="color: #a68dda;">Vue d'ensemble du parc logiciel installé par client</p>
					</div>
				</div>

				{# Bouton Nouveau déploiement conservé à l'identique #}
				<a class="takeit" href="{{ path('app_logiciel_client_new') }}" style="display: flex; align-items: center; gap: 6px; color: white; text-decoration: none; margin-left:8px; margin-top:8px;">
					<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 640 640" width="24" height="24" fill="white">
						<path d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z"/>
					</svg>
					Nouveau déploiement
				</a>
			</div>

			{# Grille d'affichage des clients #}
			{% if clients_data is empty %}
				<div class="p-12 text-center rounded-3xl" style="background: linear-gradient(160deg, #241a3d 0%, #1c1530 100%); border: 1px dashed rgba(166, 141, 218, 0.25);">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-3" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: #a68dda;">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
					</svg>
					<p class="text-sm font-medium" style="color: #a68dda;">Aucun client trouvé</p>
				</div>
			{% else %}
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{% for data in clients_data %}
						<div class="flex flex-col justify-between rounded-3xl p-6 shadow-xl transition-all duration-300 hover:-translate-y-1" style="background: linear-gradient(160deg, #241a3d 0%, #1c1530 100%); border: 1px solid rgba(166, 141, 218, 0.2); box-shadow: 0 15px 30px rgba(0, 0, 0, 0.35);">

							<div>
								{# En-tête de carte avec le nom de l'entreprise #}
								<div class="flex items-center justify-between gap-2 pb-4 mb-4" style="border-bottom: 1px solid rgba(166, 141, 218, 0.15);">
									<h2 class="text-lg font-bold tracking-tight line-clamp-1" style="color: #f3f0fb;">
										{{ data.client.raisonSocial }}
									</h2>
									<span class="text-xs font-mono font-bold px-2.5 py-1 rounded-lg shrink-0" style="background: rgba(124, 92, 191, 0.15); color: #c4b3e8;">
										#{{ data.client.id }}
									</span>
								</div>

								{# Liste des logiciels et leurs versions #}
								<ul class="space-y-3">
									{% for item in data.logiciels %}
										<div class="flex items-center justify-between p-3 rounded-xl gap-2" style="background: rgba(124, 92, 191, 0.08); border: 1px solid rgba(166, 141, 218, 0.15);">
											<span class="text-sm font-semibold line-clamp-1" style="color: #f3f0fb;">
												{{ item.logiciel.libelle }}
											</span>
											<span class="text-xs font-mono px-2 py-0.5 rounded-md shrink-0" style="background: #120d1f; color: #a68dda; border: 1px solid rgba(166, 141, 218, 0.2);">
												{{ item.versions|join(', ') }}
											</span>
										</div>
									{% else %}
										<p class="text-xs italic py-2" style="color: #a68dda;">Aucun logiciel installé.</p>
									{% endfor %}
								</ul>
							</div>

						</div>
					{% endfor %}
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
