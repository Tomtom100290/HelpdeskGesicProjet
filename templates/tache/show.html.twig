{% extends 'base.html.twig' %}

{% block title %}Tache
{% endblock %}

{% block body %}
	<div class="navbar">
		<a href="#" onclick="history.back(); return false;" class="group inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl transition-all duration-200" style="color: #7c5cbf; background-color: #7c5cbf1a;" onmouseover="this.style.backgroundColor='#7c5cbf2e'" onmouseout="this.style.backgroundColor='#7c5cbf1a'">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
			</svg>
			Retour
		</a>

		<h1>Tache</h1>
	</div>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ tache.id }}</td>
			</tr>
			<tr>
				<th>DateCreation</th>
				<td>{{ tache.dateCreation ? tache.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Libelle</th>
				<td>{{ tache.libelle }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ tache.description }}</td>
			</tr>
			<tr>
				<th>DateRealisation</th>
				<td>{{ tache.dateRealisation ? tache.dateRealisation|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Statut</th>
				<td>{{ tache.statut }}</td>
			</tr>
		</tbody>
	</table>

	<a href="{{ path('app_tache_index') }}">back to list</a>

	<a href="{{ path('app_tache_edit', {'id': tache.id}) }}">edit</a>

	{{ include('tache/_delete_form.html.twig') }}
{% endblock %}
