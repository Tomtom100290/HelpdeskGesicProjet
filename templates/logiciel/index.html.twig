{# 
  Vue : Liste des logiciels
  Rôle : Affiche la grille des logiciels enregistrés avec la possibilité d'ajouter, consulter ou modifier chaque entrée.
  Variables attendues :
    - logiciels (array|Collection) : Liste des objets Logiciel transmis par le contrôleur (app_logiciel_index).
#}

{% extends 'base.html.twig' %}

{% block title %}Logiciels
{% endblock %}

{% block body %}
	<div
		class="min-h-screen p-4 md:p-8" style="background: radial-gradient(circle at top left, #1a1428, #120d1f); font-family: system-ui, -apple-system, sans-serif;">

		{# Large Container #}
		<div
			class="max-w-7xl mx-auto space-y-8">

			{# En-tête : Navigation & Titre principal #}
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6" style="border-bottom: 1px solid rgba(166, 141, 218, 0.2);">
				<div class="flex items-center gap-4">
					<a href="{{ path('app_ticket_index') }}" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl transition-all duration-200" style="background: rgba(124, 92, 191, 0.12); color: #c4b3e8; border: 1px solid rgba(166, 141, 218, 0.2);">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
						</svg>
						Retour aux tickets
					</a>
					<div>
						<h1 class="text-3xl font-extrabold tracking-tight" style="color: #f3f0fb;">Logiciels</h1>
						<p class="text-xs mt-0.5" style="color: #a68dda;">Gestion du catalogue applicatif</p>
					</div>
				</div>

				{# Action principale : Bouton de création #}
				<a class="takeit" href="{{ path('app_logiciel_new') }}" style="display: flex; align-items: center; gap: 6px; color: white; text-decoration: none; margin-left:8px; margin-top:8px;">
					<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 640 640" width="24" height="24" fill="white">
						<path d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z"/>
					</svg>
					Nouveau Logiciel
				</a>
			</div>

			{# Grille d'affichage des logiciels #}
			{% if logiciels is empty %}
				<div class="p-12 text-center rounded-3xl" style="background: linear-gradient(160deg, #241a3d 0%, #1c1530 100%); border: 1px dashed rgba(166, 141, 218, 0.25);">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-3" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: #a68dda;">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
					</svg>
					<p class="text-sm font-medium" style="color: #a68dda;">Aucun logiciel enregistré pour le moment.</p>
				</div>
			{% else %}
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{% for logiciel in logiciels %}
						<div class="flex flex-col justify-between rounded-3xl p-6 shadow-xl transition-all duration-300 hover:-translate-y-1" style="background: linear-gradient(160deg, #241a3d 0%, #1c1530 100%); border: 1px solid rgba(166, 141, 218, 0.2); box-shadow: 0 15px 30px rgba(0, 0, 0, 0.35);">

							<div>
								{# En-tête de la carte : Identifiant et Type #}
								<div class="flex items-center justify-between gap-2 mb-4 pb-3" style="border-bottom: 1px solid rgba(166, 141, 218, 0.12);">
									<span class="text-xs font-mono font-bold px-2.5 py-1 rounded-lg" style="background: rgba(124, 92, 191, 0.15); color: #c4b3e8;">
										#{{ logiciel.id }}
									</span>
									<span class="text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider" style="background: #120d1f; color: #a68dda; border: 1px solid rgba(166, 141, 218, 0.2);">
										{{ logiciel.typeLogiciel }}
									</span>
								</div>

								{# Corps de la carte : Titre et Description #}
								<div class="space-y-2 mb-6">
									<h3 class="text-lg font-bold tracking-tight line-clamp-1" style="color: #f3f0fb;">
										{{ logiciel.libelle }}
									</h3>
									<p class="text-xs line-clamp-3 leading-relaxed" style="color: #a68dda;">
										{{ logiciel.description ?: 'Aucune description disponible.' }}
									</p>
								</div>
							</div>

							{# Pied de carte : Actions séparées avec space-between et Modifier en orange #}
							<div class="flex items-center justify-between gap-3 pt-4" style="border-top: 1px solid rgba(166, 141, 218, 0.15);">
								<a href="{{ path('app_logiciel_show', {'id': logiciel.id}) }}" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-xl text-white shadow-md transition-all duration-200 hover:opacity-90" style="background: linear-gradient(135deg, #7c5cbf, #4a3480);">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
										<path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
									</svg>
									Voir
								</a>

								<a href="{{ path('app_logiciel_edit', {'id': logiciel.id}) }}" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-xl transition-all duration-200 border" style="background: rgba(249, 115, 22, 0.12); color: #fb923c; border-color: rgba(249, 115, 22, 0.3);">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z"/>
									</svg>
									Éditer
								</a>
							</div>

						</div>
					{% endfor %}
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
